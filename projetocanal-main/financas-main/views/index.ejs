<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>FinanceIQ</title>
    <meta name="description" content="Plataforma inteligente de gestão financeira pessoal e familiar." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css" />
</head>

<body class="app-body">
    <a class="skip-link" href="#main">Saltar para o conteúdo</a>

    <!-- ============ SIDEBAR (desktop) ============ -->
    <aside class="sidebar" id="sidebar" aria-label="Navegação principal">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <div class="brand-logo-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <span class="brand-logo-text">Finance<span class="gradient-text">IQ</span></span>
            </div>
            <div class="plan-chip" id="planChipSide" role="status"></div>
        </div>

        <nav class="sidebar-nav" id="navMain" role="navigation">
            <button class="nav-item" data-view="dashboard" aria-current="true">
                <span class="nav-icon">📊</span><span class="nav-label">Dashboard</span>
            </button>
            <button class="nav-item" data-view="movements">
                <span class="nav-icon">💸</span><span class="nav-label">Movimentos</span>
            </button>
            <button class="nav-item" data-view="budget">
                <span class="nav-icon">📋</span><span class="nav-label">Orçamento</span>
            </button>
            <button class="nav-item" data-view="goals">
                <span class="nav-icon">🎯</span><span class="nav-label">Metas</span>
            </button>
            <button class="nav-item" data-view="accounts">
                <span class="nav-icon">🏦</span><span class="nav-label">Contas</span>
            </button>
            <button class="nav-item" data-view="debts">
                <span class="nav-icon">🛡️</span><span class="nav-label">Dívidas</span>
                <span class="badge-pro" data-pro>PRO</span>
            </button>
            <button class="nav-item" data-view="reports">
                <span class="nav-icon">📈</span><span class="nav-label">Relatórios</span>
            </button>
            <button class="nav-item" data-view="calendar">
                <span class="nav-icon">📅</span><span class="nav-label">Calendário</span>
            </button>
            <button class="nav-item" data-view="assistant">
                <span class="nav-icon">🤖</span><span class="nav-label">Assistente</span>
                <span class="badge-pro" data-pro>PRO</span>
            </button>
            <button class="nav-item" data-view="family">
                <span class="nav-icon">👨‍👩‍👧</span><span class="nav-label">Família</span>
                <span class="badge-pro" data-pro>PRO</span>
            </button>
            <button class="nav-item" data-view="challenges">
                <span class="nav-icon">🏆</span><span class="nav-label">Desafios</span>
                <span class="badge-pro" data-pro>PRO</span>
            </button>
            <button class="nav-item" data-view="referrals">
                <span class="nav-icon">🤝</span><span class="nav-label">Indicações</span>
            </button>
            <button class="nav-item" data-view="plans">
                <span class="nav-icon">💎</span><span class="nav-label">Planos</span>
            </button>
            <button class="nav-item nav-admin hidden" data-view="admin">
                <span class="nav-icon">🛠️</span><span class="nav-label">Administração</span>
            </button>
            <button class="nav-item" data-view="settings">
                <span class="nav-icon">⚙️</span><span class="nav-label">Definições</span>
            </button>
        </nav>

        <div class="sidebar-footer">
            <div class="streak-chip" id="streakChip" title="Racha de registos diários">🔥 <span id="streakVal">0</span></div>
            <button class="user-block" id="userMenuBtn" aria-haspopup="true">
                <div class="avatar" id="userAvatar">U</div>
                <div class="user-meta">
                    <span class="user-name" id="userName">Utilizador</span>
                    <span class="user-email" id="userEmail">—</span>
                </div>
                <span class="chevron">▾</span>
            </button>
            <div class="user-menu hidden" id="userMenu">
                <button data-action="open-settings"><span>⚙️</span> Definições</button>
                <button data-action="open-plans"><span>💎</span> Planos</button>
                <button data-action="logout"><span>🚪</span> Sair</button>
            </div>
        </div>
    </aside>
    <div class="sidebar-overlay hidden" id="sidebarOverlay"></div>

    <!-- ============ MAIN ============ -->
    <main class="main" id="main">
        <header class="topbar">
            <button class="icon-btn hamburger" id="hamburger" aria-label="Abrir menu">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div class="topbar-title">
                <h1 id="pageTitle">Dashboard</h1>
                <span class="topbar-sub" id="pageSubtitle">Visão geral</span>
            </div>
            <div class="topbar-actions">
                <div class="month-selector">
                    <button class="icon-btn" id="monthPrev" aria-label="Mês anterior">‹</button>
                    <input type="month" id="monthInput" aria-label="Mês de referência" />
                    <button class="icon-btn" id="monthNext" aria-label="Mês seguinte">›</button>
                </div>
                <button class="icon-btn" id="notifBtn" aria-label="Notificações" aria-haspopup="true">
                    🔔<span class="notif-dot hidden" id="notifDot"></span>
                </button>
                <div class="notif-panel hidden" id="notifPanel">
                    <div class="notif-head">
                        <strong>Notificações</strong>
                        <button class="text-btn" id="notifReadAll">Marcar todas</button>
                    </div>
                    <div class="notif-list" id="notifList"></div>
                </div>
                <div class="topbar-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <input type="search" id="globalSearch" placeholder="Pesquisar movimentos..." aria-label="Pesquisar" />
                </div>
            </div>
        </header>

        <!-- ============ VIEWS ============ -->
        <div class="views" id="views">
            <section class="view active" id="view-dashboard" aria-labelledby="pageTitle"></section>
            <section class="view" id="view-movements"></section>
            <section class="view" id="view-budget"></section>
            <section class="view" id="view-goals"></section>
            <section class="view" id="view-accounts"></section>
            <section class="view" id="view-debts"></section>
            <section class="view" id="view-reports"></section>
            <section class="view" id="view-calendar"></section>
            <section class="view" id="view-assistant"></section>
            <section class="view" id="view-family"></section>
            <section class="view" id="view-challenges"></section>
            <section class="view" id="view-referrals"></section>
            <section class="view" id="view-plans"></section>
            <section class="view" id="view-admin"></section>
            <section class="view" id="view-settings"></section>
        </div>
    </main>

    <!-- ============ MOBILE BOTTOM NAV ============ -->
    <nav class="bottom-nav" aria-label="Navegação móvel">
        <button class="bn-item" data-view="dashboard"><span class="bn-icon">📊</span><span class="bn-label">Início</span></button>
        <button class="bn-item" data-view="movements"><span class="bn-icon">💸</span><span class="bn-label">Mov.</span></button>
        <button class="bn-item bn-fab" id="fabMain" aria-label="Adicionar rápido"><span class="bn-icon">＋</span></button>
        <button class="bn-item" data-view="budget"><span class="bn-icon">📋</span><span class="bn-label">Orç.</span></button>
        <button class="bn-item" data-view="goals"><span class="bn-icon">🎯</span><span class="bn-label">Metas</span></button>
    </nav>

    <!-- ============ FAB (desktop) ============ -->
    <div class="fab-wrap">
        <div class="fab-menu hidden" id="fabMenu">
            <button data-fab="expense"><span>🔴</span> Despesa</button>
            <button data-fab="income"><span>🟢</span> Receita</button>
            <button data-fab="transfer"><span>🔁</span> Transferência</button>
            <button data-fab="ocr"><span>📷</span> Recibo</button>
            <button data-fab="import"><span>📥</span> Importar</button>
        </div>
        <button class="fab" id="fab" aria-label="Ações rápidas" aria-expanded="false">＋</button>
    </div>

    <!-- ============ MODAIS ============ -->
    <div class="modal-overlay hidden" id="modalOverlay" aria-hidden="true">
        <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"></div>
    </div>

    <div class="modal-overlay hidden" id="paywallOverlay" aria-hidden="true">
        <div class="modal paywall-modal" role="dialog" aria-modal="true" aria-labelledby="paywallTitle"></div>
    </div>

    <div class="modal-overlay hidden" id="onboardOverlay" aria-hidden="true">
        <div class="modal onboard-modal" role="dialog" aria-modal="true" aria-labelledby="onboardTitle"></div>
    </div>

    <div class="toast-wrap" id="toastWrap" aria-live="polite"></div>

    <script src="/i18n.js"></script>
    <script src="/app.js"></script>
</body>
</html>