# Hostinger Node.js Hosting Configuration
# Copy this file to .env and update the values

# Session secret - change this to a random string
SESSION_SECRET=your-random-secret-here-change-me

# Server port (Hostinger uses process.env.PORT internally)
PORT=3000

# Node environment
NODE_ENV=production

# OPCIONAL - sobrescreve a localizacao da base de dados e das sessoes.
# Em producao (NODE_ENV=production) o default ja e ~/.financeiq/ (estavel entre deploys).
# So defina estes se quiser caminhos especificos.
# DB_PATH=/home/USER/.financeiq/financeiq.db
# SESSION_DB_PATH=/home/USER/.financeiq/sessions.db

# OPCIONAL - promove o utilizador com este email a admin em cada arranque.
# Use depois de registar a conta no site (ou para restaurar um admin existente).
ADMIN_EMAIL=

# SUPABASE - ligacao a base de dados PostgreSQL (opcional).
# Se definido, a app usa o Supabase em vez do SQLite local.
# A connection string vem de: Supabase > Settings > Database > Connection string.
# SUPABASE_DB_URL=postgresql://postgres.XXXX:password@aws-0-region.pooler.supabase.com:6543/postgres

# OPCIONAL - tamanho do buffer interno de resultados (MB).
# SUPABASE_RESULT_BUF_MB=32

